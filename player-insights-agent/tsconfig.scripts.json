// The release tooling under scripts/, which nothing typechecked until now.
//
// `npm run typecheck` builds server and client only, so every TypeScript file in
// scripts/ reached a release having been transpiled by vitest and never checked.
// That is tolerable for a script somebody runs by hand and watches; it is not
// tolerable for a gate that decides whether a release may be promoted.
//
// Scoped to scripts/certify/ rather than to scripts/ as a whole. Widening it is a
// separate change: the other scripts predate this project and would bring their
// own errors to a commit that is not about them.
{
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "./"
  },
  "include": ["scripts/certify/**/*", "scripts/certify-release.mts"],
  "exclude": ["node_modules", "dist"]
}
